{
    "name": "mestiaque/utility",
    "description": "Utility module for Laravel (by M. Estiaque Ahmed Khan)",
    "type": "library",
    "keywords": [
        "Laravel",
        "Utility",
        "Estiaque"
    ],
    "authors": [
        {
            "name": "M. Estiaque Ahmed Khan",
            "email": "info@mestiaque.com",
            "homepage": "https://mestiaque.com"
        }
    ],
    "require": {
        "php": "^8.2"
    },
    "require-dev": {
        "laravel/framework": "^11.0|^12.0",
        "orchestra/testbench": "^9.0|^10.0",
        "phpunit/phpunit": "^10.5|^11.0"
    },
    "suggest": {
        "intervention/image": "Required for image resize and compression on upload (^4.0)",
        "ext-pcntl": "Lets the Media Downloader stop yt-dlp cleanly on cancel/timeout"
    },
    "autoload": {
        "psr-4": {
            "ME\\Utility\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "ME\\Utility\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "ME\\Utility\\UtilityServiceProvider"
            ]
        }
    },
    "license": "MIT",
    "minimum-stability": "dev",
    "prefer-stable": true,
    "scripts": {
        "test": "phpunit"
    }
}
